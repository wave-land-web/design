{
  "name": "@wave-land-web/design",
  "version": "1.0.0",
  "description": "Wave Land's design system: Tailwind 4 tokens and utilities, fonts, motion, and the shared Astro and React components",
  "private": true,
  "type": "module",
  "repository": "github:wave-land-web/design",
  "keywords": [
    "astro-component"
  ],
  "exports": {
    "./config": "./config.js",
    "./components/*": "./components/*",
    "./fonts/*": "./fonts/*",
    "./styles/*": "./styles/*"
  },
  "files": [
    "components",
    "config.js",
    "fonts",
    "icons",
    "styles"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "@astrojs/react": "^7.0.0",
    "astro": "^7.0.0",
    "astro-icon": "^1.1.0",
    "react": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0"
  }
}
